{
  "name": "cc2im",
  "version": "0.1.0",
  "description": "Claude Code to IM bridge — chat with Claude Code via Lark and Discord",
  "type": "module",
  "main": "dist/index.js",
  "bin": {
    "cc2im": "dist/cli.js"
  },
  "scripts": {
    "build": "tsc && chmod +x dist/cli.js",
    "start": "node dist/index.js",
    "dev": "tsx watch --include ../../config.yaml src/cli.ts web --port 3000",
    "test": "vitest run"
  },
  "dependencies": {
    "@cc2im/core": "*",
    "@cc2im/server": "*",
    "@larksuiteoapi/node-sdk": "^1.59.0",
    "discord.js": "^14.16.0",
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/ws": "^8.5.0",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0",
    "vitest": "^2.1.0"
  }
}
