# Platform credentials (prefer env vars: DISCORD_TOKEN, LARK_APP_ID, LARK_APP_SECRET)
# Lark/飞书 (prefer env vars: LARK_APP_ID, LARK_APP_SECRET, LARK_OWNER_OPEN_ID)
lark:
  appId: ""
  appSecret: ""
  ownerOpenId: ""  # your open_id, so the bot auto-invites you to project groups

discord:
  token: ""

# Project → directory mappings
projects:
  - name: "my-project"
    directory: "/path/to/project"
    platforms:
      discord: true
      lark: true

# Claude Code CLI settings
claude:
  command: "claude"
  defaultArgs: ["--print", "--output-format", "stream-json", "--verbose", "--dangerously-skip-permissions"]
  bufferInterval: 500
  timeout: 300000

# Output formatting
formatter:
  maxMessageLength:
    discord: 2000
    lark: 30000
  maxConcurrentProcesses: 5
